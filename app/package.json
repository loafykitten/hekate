{
  "name": "hekate-slice",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "verify:screens": "node scripts/verify/screenshots.mjs",
    "verify:clips": "node scripts/verify/clip-flow.mjs",
    "verify:blend": "node scripts/verify/blend-stress.mjs",
    "verify:strip": "node scripts/verify/transition-strip.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
