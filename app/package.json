{
  "name": "hekate-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:screens": "node scripts/verify/screenshots.mjs",
    "verify:mail": "node scripts/verify/mail.mjs",
    "verify:changes": "node scripts/verify/changes.mjs",
    "verify:clips": "node scripts/verify/clip-flow.mjs",
    "verify:blend": "node scripts/verify/blend-stress.mjs",
    "verify:strip": "node scripts/verify/transition-strip.mjs",
    "verify:loop": "node scripts/verify/frame-loop.mjs",
    "verify:tail": "node scripts/verify/tail.mjs",
    "verify:voice": "node scripts/verify/voice.mjs",
    "verify:diary": "node scripts/verify/diary.mjs",
    "verify:briefing": "node scripts/verify/briefing.mjs",
    "verify:lipsync": "node scripts/verify/lipsync.mjs",
    "verify:offline": "node scripts/verify/offline.mjs",
    "verify:tour": "node scripts/verify/tour.mjs",
    "verify:checkin": "node scripts/verify/checkin.mjs",
    "verify:money": "node scripts/verify/money.mjs",
    "verify:talkkey": "node scripts/verify/talkkey.mjs"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "5.104.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/project-service": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    }
  }
}
