# The deployer's own settings, kept apart from hekate.env so it never sees mail or API secrets.
# All optional.

# A failed deploy is sent to the owner's Telegram chat (the same bot and chat as in hekate.env).
HEKATE_TELEGRAM_BOT_TOKEN=
HEKATE_TELEGRAM_CHAT_ID=

# A dead-man's switch: pinged every round while Hekate is healthy. Use a check with a 1-minute
# period and a few minutes' grace (e.g. https://hc-ping.com/<uuid> from healthchecks.io), and
# point its alerts at Telegram, so the owner hears when the pings stop.
HEALTHCHECK_URL=
