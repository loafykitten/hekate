# Copy to hekate.env next to compose.yaml on the server and `chmod 600` it.
# Never commit the real file. Unset integrations are reported as unavailable, not faked.

# What Renamon calls you, and your local time zone (IANA name).
HEKATE_TAMER_NAME=YourName
HEKATE_TIMEZONE=America/New_York
HEKATE_LOG_LEVEL=info

# Mail: up to nine IMAP accounts, numbered 1..9. Use an app-specific password, never the account
# password. HOST defaults to imappro.zoho.com (port 993, TLS). NAME is the label shown in the app;
# it defaults to the domain without its TLD (rika@example.com -> "example") and must be unique.
# ARCHIVE is the folder "archive" moves mail to.
#HEKATE_MAIL_1_USER=rika@example.com
#HEKATE_MAIL_1_PASS=app-password-here
#HEKATE_MAIL_1_NAME=personal
#HEKATE_MAIL_1_HOST=imappro.zoho.com
#HEKATE_MAIL_1_ARCHIVE=Archive
#HEKATE_MAIL_2_USER=rika@example.org
#HEKATE_MAIL_2_PASS=another-app-password
# How often the inbox is checked and new mail classified (Go duration, at least 1m), and the
# model for the many small classification calls.
#HEKATE_MAIL_SWEEP=10m
#HEKATE_MODEL_BULK=glm-5.3-flash-flex
#HEKATE_MODEL_BULK_EFFORT=low
