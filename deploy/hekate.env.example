# Copy to hekate.env next to compose.yaml on the server and `chmod 600` it.
# Never commit the real file. Unset integrations are reported as unavailable, not faked.

# What Renamon calls you, and your local time zone (IANA name).
HEKATE_TAMER_NAME=YourName
HEKATE_TIMEZONE=America/New_York
HEKATE_LOG_LEVEL=info

# Mail: up to nine IMAP accounts, numbered 1..9. Use an app-specific password, never the account
# password. HOST defaults to imappro.zoho.com (port 993, TLS). NAME is the label shown in the app;
# it defaults to the domain without its TLD (rika@example.com -> "example") and must be unique.
# ARCHIVE is the folder "archive" moves mail to.
#HEKATE_MAIL_1_USER=rika@example.com
#HEKATE_MAIL_1_PASS=app-password-here
#HEKATE_MAIL_1_NAME=personal
#HEKATE_MAIL_1_HOST=imappro.zoho.com
#HEKATE_MAIL_1_ARCHIVE=Archive
#HEKATE_MAIL_2_USER=rika@example.org
#HEKATE_MAIL_2_PASS=another-app-password
# How often the inbox is checked and new mail classified (Go duration, at least 1m), and the
# model for the many small classification calls.
#HEKATE_MAIL_SWEEP=10m
#HEKATE_MODEL_BULK=glm-5.3-flash-flex
#HEKATE_MODEL_BULK_EFFORT=low

# Telegram: the backup channel. A notification web push can't get to any device (none subscribed,
# or every send failed) goes to this chat instead; approvals come with Allow/Deny buttons, and a
# reply to one denies it with the reply as the reason. Make a bot with @BotFather, send it /start,
# and read the chat id from https://api.telegram.org/bot<token>/getUpdates. Both or neither.
#HEKATE_TELEGRAM_BOT_TOKEN=123456:bot-token-here
#HEKATE_TELEGRAM_CHAT_ID=123456789

# Bank data (read-only), through Plaid. Create a Plaid account, copy the client id and the secret for
# the environment you use from the dashboard. Only the Transactions product is used; nothing here can
# move money. Both keys or neither. PLAID_ENV is production (the default, real banks) or sandbox
# (fake test banks).
#PLAID_CLIENT_ID=your-plaid-client-id
#PLAID_SECRET=your-plaid-secret
#PLAID_ENV=production
# Banks that link through their own site send you back here afterwards. It must be
# https://<your hekate host>/money/oauth, registered in the Plaid dashboard under API > Allowed
# redirect URIs. Leave it unset if every bank links inside the app.
#PLAID_REDIRECT_URI=https://hekate.example.com/money/oauth

# Her lab: a VM on the homelab she runs commands on (deploy/lab/README.md). Set to the VM's tailnet
# address once build-vm.sh prints it, and mount the stack's lab/ directories (compose.example.yaml).
# HEKATE_LAB_NAME is what your devices call the VM, for the addresses of apps she runs there.
#HEKATE_LAB_HOST=100.64.0.10
#HEKATE_LAB_NAME=hekate-lab
