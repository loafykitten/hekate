#!/usr/sbin/nft -f
# The lab VM reaches the internet and nothing else. Loaded by hekate-lab-firewall.service; a table
# of its own, so a drop here holds whatever libvirt, Docker or firewalld accept in theirs.
#
# The counters are evidence for Hekate's security check (labctl stats): a lab that tries to send
# mail straight to port 25, or to open connections into private networks, is misbehaving.

table inet hekate_lab
delete table inet hekate_lab

table inet hekate_lab {
	counter smtp_out {}
	counter private_tcp {}
	counter host_tcp {}

	set private4 {
		type ipv4_addr
		flags interval
		elements = {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4
		}
	}

	# The VM may ask the host for an address and for DNS (libvirt's dnsmasq), nothing more. A first
	# DHCP request is a broadcast, so DHCP is let in whatever its destination.
	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname != "virbr-lab" accept
		udp sport 68 udp dport 67 accept
		ip daddr 10.231.0.1 udp dport 53 accept
		ip daddr 10.231.0.1 tcp dport 53 accept
		icmp type echo-request accept
		meta l4proto tcp ct state new counter name host_tcp drop
		drop
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname != "virbr-lab" accept
		meta nfproto ipv6 drop
		tcp dport 25 counter name smtp_out drop
		ip daddr @private4 meta l4proto tcp ct state new counter name private_tcp drop
		ip daddr @private4 drop
	}
}
