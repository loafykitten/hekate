#!/usr/bin/env bash
# lab-docker-ro: the lab reviewer's docker. Runs docker as root for commands that only look and
# refuses everything else. The reviewer account may run only this and the firewall listing with
# sudo (reviewer-setup.sh); its docker is a wrapper that calls this. Hekate checks commands
# against the same list before sending them (service/internal/lab/readonly.go).
set -euo pipefail
export LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

die() {
  echo "lab-docker-ro: $*" >&2
  exit 126
}
# has <option>... -- <arg>...: whether any arg is one of the options (or --option=value).
has() {
  local opts=() a o
  while [[ $# -gt 0 && "$1" != -- ]]; do opts+=("$1"); shift; done
  shift
  for a in "$@"; do
    for o in "${opts[@]}"; do
      [[ "$a" == "$o" || "$a" == "$o="* ]] && return 0
    done
  done
  return 1
}
# stacks_only <path>: compose may only read stacks under /opt/stacks.
stacks_only() {
  local p
  p="$(realpath -m -- "$1")"
  [[ "$p" == /opt/stacks || "$p" == /opt/stacks/* ]] || die "compose reads stacks under /opt/stacks only, not $1"
}

[[ $# -gt 0 ]] || die "usage: docker <command> [args]: read-only commands only"
sub="$1"
shift
case "$sub" in
  version | info | ps | images | inspect | top | port | diff) ;;
  logs) ! has -f --follow -- "$@" || die "logs can't be followed here" ;;
  stats) has --no-stream -- "$@" || die "stats needs --no-stream" ;;
  manifest) [[ "${1:-}" == inspect ]] || die "only manifest inspect" ;;
  buildx)
    [[ "${1:-} ${2:-}" == "imagetools inspect" || "${1:-}" == ls || "${1:-}" == version ]] \
      || die "only buildx imagetools inspect, ls and version"
    ;;
  network | volume | image | container | system | context)
    case "${1:-}" in
      ls | list | inspect | history | df | top | port | diff | info | show) ;;
      logs) ! has -f --follow -- "$@" || die "logs can't be followed here" ;;
      *) die "only looking: $sub ls, inspect and the like" ;;
    esac
    ;;
  compose)
    args=("$@")
    i=0
    dir=""
    while [[ $i -lt ${#args[@]} && "${args[$i]}" == -* ]]; do
      a="${args[$i]}"
      case "$a" in
        -f | --file | --project-directory | --env-file)
          stacks_only "${args[$((i + 1))]:-}"
          [[ "$a" == --env-file ]] || dir=1
          i=$((i + 2))
          ;;
        --file=* | --project-directory=* | --env-file=*)
          stacks_only "${a#*=}"
          [[ "$a" == --env-file=* ]] || dir=1
          i=$((i + 1))
          ;;
        -p | --project-name | --profile | --ansi | --progress) i=$((i + 2)) ;;
        --project-name=* | --profile=* | --ansi=* | --progress=*) i=$((i + 1)) ;;
        *) die "compose option $a isn't allowed here" ;;
      esac
    done
    # Without a file or directory, compose reads the stack in the current directory.
    [[ -n "$dir" ]] || stacks_only "$PWD"
    rest=("${args[@]:$((i + 1))}")
    case "${args[$i]:-}" in
      config)
        # -o and --output write a file, in any spelling: -o x, -ox, -qo x, --output=x.
        for o in "${rest[@]}"; do
          [[ "$o" == --output* || ("$o" == -[!-]* && "$o" == *o*) ]] && die "config can't write a file here"
        done
        ;;
      ps | ls | images | top | port | version) ;;
      logs) ! has -f --follow -- "${rest[@]}" || die "logs can't be followed here" ;;
      *) die "only looking: compose config, ps, ls, images, logs and the like" ;;
    esac
    ;;
  *) die "$sub isn't allowed: read-only commands only (ps, inspect, logs, images, compose config/ps, manifest inspect...)" ;;
esac
exec docker "$sub" "$@"
