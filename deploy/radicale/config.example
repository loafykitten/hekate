# Radicale: the owner's calendar. Phones and computers add it as a CalDAV account through the
# reverse proxy; Hekate talks to it on loopback.
[server]
hosts = 127.0.0.1:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = autodetect

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = info
mask_passwords = True
